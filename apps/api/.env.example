# PostgreSQL (proyecto Supabase). DATABASE_URL es el Transaction Pooler (puerto 6543,
# runtime de la app vía Prisma driver adapter); DIRECT_URL es la conexión directa/de
# sesión (puerto 5432, usada solo por Prisma Migrate). Sacar ambas del dashboard de
# Supabase: Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Autenticación
AUTH_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS: origen permitido para el frontend (apps/web)
CORS_ALLOWED_ORIGIN=http://localhost:3000
