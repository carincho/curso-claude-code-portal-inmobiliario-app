# URL del backend (apps/api), usada por el servidor de apps/web para consumir la API REST
API_URL=http://localhost:3001

# URL pública del frontend, usada para generar metadata absoluta (Open Graph, canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Web3Forms (access key público por diseño de Web3Forms, ver plan.md §13)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
